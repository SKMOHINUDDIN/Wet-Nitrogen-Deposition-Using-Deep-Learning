        else:
            print("Observed: USA + Europe + China | Unobserved: Rest")
        print('='*120)
        
        obs_mask, obs_values = load_observations(year)
        pred_base = load_prediction(year)
        
        n_obs = int(np.sum(obs_mask & np.isfinite(pred_base)))
        n_unobs = int(np.sum((~obs_mask) & np.isfinite(pred_base)))
        
        print(f"Pixels: Observed={n_obs:,} | Unobserved={n_unobs:,}")
        
        # Validation
        if n_obs > 0:
            obs_pix = obs_mask & np.isfinite(pred_base) & np.isfinite(obs_values)
            rmse = np.sqrt(np.mean((obs_values[obs_pix] - pred_base[obs_pix])**2))
            r2 = 1 - np.sum((obs_values[obs_pix] - pred_base[obs_pix])**2) / \
                     np.sum((obs_values[obs_pix] - np.mean(obs_values[obs_pix]))**2)
        else:
            rmse, r2 = np.nan, np.nan
        
        print(f"Validation: RMSE={rmse:.3f} kg/ha | R²={r2:.3f}")
        
        # MC Dropout + Bounded Spatial
        obs_total, obs_unc_pct, unobs_total, unobs_unc_pct = mc_dropout_with_bounded_spatial(
            year, model, sx_mean, sx_scale, sy_mean, sy_scale, obs_mask, n_samples=MC_SAMPLES
        )
        
        global_total = obs_total + unobs_total
        obs_unc_Tg = (obs_unc_pct / 100) * obs_total
        unobs_unc_Tg = (unobs_unc_pct / 100) * unobs_total
        global_unc_Tg = np.sqrt(obs_unc_Tg**2 + unobs_unc_Tg**2)
        global_unc_pct = 100 * global_unc_Tg / global_total if global_total != 0 else np.nan
        
        print(f"\n✓ Observed:   {obs_total:.2f} Tg ± {obs_unc_pct:.2f}%")
        print(f"✓ Unobserved: {unobs_total:.2f} Tg ± {unobs_unc_pct:.2f}%")
        print(f"✓ Global:     {global_total:.2f} Tg ± {global_unc_pct:.2f}%")
        
        rows.append({
            "Year": year,
            "Observed_Total_Tg": obs_total,
            "Observed_Uncertainty_%": obs_unc_pct,
            "Unobserved_Total_Tg": unobs_total,
            "Unobserved_Uncertainty_%": unobs_unc_pct,
            "Global_Total_Tg": global_total,
            "Global_Uncertainty_%": global_unc_pct,
            "RMSE_kg_ha": rmse,
            "R2": r2,
        })
    
    df = pd.DataFrame(rows).round(2)
