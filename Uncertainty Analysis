# ============================================================
# BOUNDED SPATIAL MULTIPLIER
# ============================================================
def compute_spatial_multiplier_bounded(obs_mask, length_scale_km=1000.0, 
                                       max_penalty=1.5, sample_obs=10000):
    """
    Bounded spatial multiplier using saturating function.
    
    Formula: multiplier = 1 + max_penalty × (1 - exp(-distance/length_scale))
    
    This ensures:
    - At distance = 0: multiplier = 1.0
    - At distance = length_scale: multiplier ≈ 1 + 0.63 × max_penalty
    - At distance → ∞: multiplier → 1 + max_penalty
    
    For length_scale=1000km, max_penalty=1.5:
    - 1000 km away: ~1.95x
    - 3000 km away: ~2.45x
    - Very far: 2.5x max
    """
    obs_rows, obs_cols = np.where(obs_mask)
    
    if len(obs_rows) == 0:
        return np.ones((T_H, T_W))
    
    # Subsample for efficiency
    if len(obs_rows) > sample_obs:
        idx = np.random.choice(len(obs_rows), sample_obs, replace=False)
        obs_rows_sample = obs_rows[idx]
        obs_cols_sample = obs_cols[idx]
    else:
        obs_rows_sample = obs_rows
        obs_cols_sample = obs_cols
    
    # Get coordinates
    obs_coords = []
    for i in range(len(obs_rows_sample)):
        xlon, ylat = xy(T_TX, int(obs_rows_sample[i]), int(obs_cols_sample[i]), offset='center')
        obs_coords.append([ylat, xlon])
    obs_coords = np.array(obs_coords)
    
    print(f"  Building KD-tree from {len(obs_coords):,} observed locations...")
    tree = cKDTree(obs_coords)
    
    # Calculate bounded multiplier
    multiplier = np.ones((T_H, T_W), dtype=np.float32)
    
    # Sample grid for speed
    stride = 5
    
    for r in range(0, T_H, stride):
        for c in range(0, T_W, stride):
            xlon, ylat = xy(T_TX, r, c, offset='center')
            distance_deg, _ = tree.query([ylat, xlon])
            distance_km = distance_deg * 111.0
            
            # Bounded formula: 1 + max_penalty × (1 - exp(-d/L))
            penalty = max_penalty * (1.0 - np.exp(-distance_km / length_scale_km))
            mult_val = 1.0 + penalty
            
            # Fill surrounding pixels
            multiplier[r:min(r+stride, T_H), c:min(c+stride, T_W)] = mult_val
    
    return multiplier

# ============================================================
# MC DROPOUT
# ============================================================
def mc_dropout_with_bounded_spatial(year, model, sx_mean, sx_scale, sy_mean, sy_scale, 
                                    obs_mask, n_samples=100, sample_pixels=50000):
    
    pred = load_prediction(year)
    valid = np.isfinite(pred)
    
    # Load predictors
    b = map_year_to_band(year, EDGAR_BASE_YEAR)
    nox, nx_tx, nx_crs, _ = read_band(EDGAR_NOX_PATH, b)
    nh3, nh_tx, nh_crs, _ = read_band(EDGAR_NH3_PATH, b)
    ppt, pp_tx, pp_crs, _ = read_band(PPT_TIF, b)
    
    if (nox.shape != (T_H, T_W)) or (nx_tx != T_TX):
        nox = resample_to(nox, nx_tx, nx_crs, (T_H, T_W), T_TX, T_CRS)
    if (nh3.shape != (T_H, T_W)) or (nh_tx != T_TX):
        nh3 = resample_to(nh3, nh_tx, nh_crs, (T_H, T_W), T_TX, T_CRS)
    if (ppt.shape != (T_H, T_W)) or (pp_tx != T_TX):
        ppt = resample_to(ppt, pp_tx, pp_crs, (T_H, T_W), T_TX, T_CRS)
    
    nox = np.clip(nox, 0, 1e7)
    nh3 = np.clip(nh3, 0, 1e7)
    ppt = np.clip(ppt, 0, 1e4)
    
    obs_valid = obs_mask & valid & np.isfinite(nox) & np.isfinite(nh3) & np.isfinite(ppt)
    unobs_valid = (~obs_mask) & valid & np.isfinite(nox) & np.isfinite(nh3) & np.isfinite(ppt)
    
    # MC Dropout
    obs_rows, obs_cols = np.where(obs_valid)
    unobs_rows, unobs_cols = np.where(unobs_valid)
    
    n_obs_sample = min(sample_pixels // 2, len(obs_rows))
    n_unobs_sample = min(sample_pixels // 2, len(unobs_rows))
    
    if n_obs_sample > 0:
        obs_idx = np.random.choice(len(obs_rows), n_obs_sample, replace=False)
        obs_r, obs_c = obs_rows[obs_idx], obs_cols[obs_idx]
    else:
        obs_r, obs_c = np.array([]), np.array([])
    
    if n_unobs_sample > 0:
        unobs_idx = np.random.choice(len(unobs_rows), n_unobs_sample, replace=False)
        unobs_r, unobs_c = unobs_rows[unobs_idx], unobs_cols[unobs_idx]
    else:
        unobs_r, unobs_c = np.array([]), np.array([])
    
    all_r = np.concatenate([obs_r, unobs_r])
    all_c = np.concatenate([obs_c, unobs_c])
    
    if len(all_r) == 0:
        obs_total = np.sum(to_Tg(pred[obs_valid], area_ha[obs_valid]))
        unobs_total = np.sum(to_Tg(pred[unobs_valid], area_ha[unobs_valid]))
        return obs_total, 22.0, unobs_total, 28.0
    
    print(f"  MC dropout on {len(all_r):,} sampled pixels...")
    
    # Build features
    yrn = (year - 2000.0) / 50.0
    lat = np.empty(len(all_r), float)
    lon = np.empty(len(all_r), float)
    
    for i in range(len(all_r)):
        xlon, ylat = xy(T_TX, int(all_r[i]), int(all_c[i]), offset='center')
        lon[i] = xlon
        lat[i] = ylat
    
    features = np.column_stack([
        nox[all_r, all_c],
        nh3[all_r, all_c],
        ppt[all_r, all_c],
        lat, lon,
        np.full(len(all_r), yrn)
    ]).astype(np.float32)
    
    features_scaled = (features - sx_mean) / sx_scale
    
    # MC Dropout
    predictions = []
    for t in range(n_samples):
        if t % 25 == 0:
            print(f"    Sample {t}/{n_samples}")
        pred_scaled = model(features_scaled, training=True).numpy().ravel()
        pred_unscaled = pred_scaled * sy_scale + sy_mean
        predictions.append(pred_unscaled)
    
    predictions = np.array(predictions)
    std_pred = np.std(predictions, axis=0)
    
    # Separate obs/unobs
    is_obs = np.concatenate([np.ones(len(obs_r), bool), np.zeros(len(unobs_r), bool)])
    
    obs_mc_unc = np.mean(std_pred[is_obs]) if np.sum(is_obs) > 0 else 1.5
    unobs_mc_unc = np.mean(std_pred[~is_obs]) if np.sum(~is_obs) > 0 else 1.5
    
    print(f"  MC dropout: Obs={obs_mc_unc:.3f} kg/ha | Unobs={unobs_mc_unc:.3f} kg/ha")
    
    # Bounded spatial multiplier
    print(f"  Computing bounded spatial multipliers...")
    spatial_mult = compute_spatial_multiplier_bounded(
        obs_mask, 
        length_scale_km=SPATIAL_LENGTH_SCALE, 
        max_penalty=MAX_SPATIAL_PENALTY
    )
    
    obs_spatial_mult = np.mean(spatial_mult[obs_valid])
    unobs_spatial_mult = np.mean(spatial_mult[unobs_valid])
    
    print(f"  Spatial multiplier: Obs={obs_spatial_mult:.2f}x | Unobs={unobs_spatial_mult:.2f}x")
    
    # Combined
    obs_combined_unc = obs_mc_unc * obs_spatial_mult
    unobs_combined_unc = unobs_mc_unc * unobs_spatial_mult
    
    print(f"  ✓ COMBINED: Obs={obs_combined_unc:.3f} kg/ha | Unobs={unobs_combined_unc:.3f} kg/ha")
    
    # Totals
    obs_total = np.sum(to_Tg(pred[obs_valid], area_ha[obs_valid]))
    unobs_total = np.sum(to_Tg(pred[unobs_valid], area_ha[unobs_valid]))
    
    # As percentage
    obs_unc_pct = 100 * obs_combined_unc / np.mean(pred[obs_valid]) if np.sum(obs_valid) > 0 else 22.0
    unobs_unc_pct = 100 * unobs_combined_unc / np.mean(pred[unobs_valid]) if np.sum(unobs_valid) > 0 else 28.0
    
    return obs_total, obs_unc_pct, unobs_total, unobs_unc_pct

