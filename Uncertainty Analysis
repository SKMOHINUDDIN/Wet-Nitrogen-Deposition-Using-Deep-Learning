def map_year_to_band(year, base):
    return int(year - base + 1)

def _clean(a, nodata):
    aa = a.astype(np.float64, copy=False)
    if nodata is not None and np.isfinite(nodata):
        aa[aa == nodata] = np.nan
    for s in NODATA_SENTINELS:
        aa = np.where(aa == s, np.nan, aa)
    aa[(aa <= -1e19) | (aa >= 1e19)] = np.nan
    return aa

def read_band(fp, band_idx):
    with rasterio.open(fp) as src:
        if not (1 <= band_idx <= src.count):
            raise ValueError(f"{fp}: band {band_idx}/{src.count}")
        arr = src.read(band_idx)
        return _clean(arr, src.nodata), src.transform, src.crs, src.profile

def resample_to(arr, s_tx, s_crs, d_shape, d_tx, d_crs, method="bilinear"):
    resamp = {"nearest": Resampling.nearest, "bilinear": Resampling.bilinear}.get(method, Resampling.bilinear)
    out = np.full(d_shape, np.nan, dtype=np.float64)
    reproject(source=arr.astype(np.float64, copy=False),
              destination=out,
              src_transform=s_tx, src_crs=s_crs,
              dst_transform=d_tx, dst_crs=d_crs,
              src_nodata=np.nan, dst_nodata=np.nan,
              resampling=resamp, num_threads=2)
    out[(out <= -1e19) | (out >= 1e19)] = np.nan
    return out

def pixel_area_ha_from_geographic(transform, height, width):
    R, dlon, dlat = 6378137.0, transform.a, -transform.e
    dlon_rad = np.deg2rad(abs(dlon))
    lat_top = transform.f
    lat_edges = lat_top - np.arange(0, height + 1) * dlat
    lat1, lat2 = np.deg2rad(lat_edges[:-1]), np.deg2rad(lat_edges[1:])
    row_area_m2 = (R * R) * dlon_rad * np.abs(np.sin(lat1) - np.sin(lat2))
    area_ha = np.repeat((row_area_m2 / 10000.0)[:, None], width, axis=1)
    return area_ha

def to_Tg(values_kg_ha, area_ha):
    return (values_kg_ha * area_ha) / 1e9

